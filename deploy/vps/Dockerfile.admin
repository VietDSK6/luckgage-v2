FROM node:24-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/admin/package.json apps/admin/package.json
RUN npm ci --workspace @luckgage/admin --include-workspace-root --no-audit --no-fund

COPY apps/admin apps/admin
ARG VITE_API_BASE_URL
ENV VITE_APP_ENV=demo
RUN test -n "$VITE_API_BASE_URL" && npm run build --workspace @luckgage/admin

FROM nginx:1.29-alpine
COPY deploy/vps/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html
EXPOSE 3000
