{
  "expo": {
    "name": "luckgage",
    "slug": "luckgage",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "luckgage",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
