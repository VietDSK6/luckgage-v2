{
  "expo": {
    "name": "luckgage",
    "slug": "luckgage",
    "version": "0.1.0",
    "icon": "./assets/brand/app-icon.png",
    "orientation": "portrait",
    "scheme": "luckgage",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F7F7F2",
      "image": "./assets/brand/luki-mascot.png",
      "resizeMode": "contain"
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow luckgage to scan trip invite QR codes",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
