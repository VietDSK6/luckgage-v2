{
  "expo": {
    "name": "luckgage",
    "slug": "luckgage",
    "version": "0.1.0",
    "icon": "./assets/brand/app-icon.png",
    "orientation": "portrait",
    "scheme": "luckgage",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FFF7E8",
      "image": "./assets/brand/luki-mascot.png",
      "resizeMode": "contain"
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
