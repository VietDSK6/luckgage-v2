  "info": {
    "title": "luckgage API",
    "description": "Versioned REST API for luckgage mobile and admin clients.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "luckgage_admin_session"
      }
    },
    "schemas": {
      "UserRole": {
        "type": "string",
        "enum": [
          "USER",
          "ADMIN"
        ]
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "SUSPENDED"
        ]
      },
      "UserLocale": {
        "type": "string",
        "enum": [
          "vi",
          "en"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string",
            "example": "Mai"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserStatus"
              }
            ]
          },
          "locale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserLocale"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "status",
          "locale"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ]
      },
      "ValidationFieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "email"
          },
          "code": {
            "type": "string",
            "example": "IS_EMAIL"
          },
          "message": {
            "type": "string",
            "example": "email must be an email"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "number",
            "example": 422
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "title": {
            "type": "string",
            "example": "Validation failed"
          },
          "detail": {
            "type": "string",
            "example": "One or more fields are invalid."
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationFieldErrorDto"
            }
          }
        },
        "required": [
          "status",
          "code",
          "title",
          "detail",
          "requestId"
        ]
      },
      "AdminLoginResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "csrfToken": {
            "type": "string",
            "description": "Send as x-csrf-token on mutating admin requests."
          }
        },
        "required": [
          "user",
          "csrfToken"
        ]
      },
      "AdminUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string",
            "example": "Mai"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserStatus"
              }
            ]
          },
          "locale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserLocale"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "status",
          "locale",
          "createdAt",
          "updatedAt"
        ]
      },
      "AdminUsersPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminUserDto"
            }
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "totalItems": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ]
      },
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "up"
          },
          "service": {
            "type": "string",
            "example": "luckgage-api"
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "up"
          },
          "service": {
            "type": "string",
            "example": "luckgage-api"
          },
          "checks": {
            "type": "object",
            "example": {
              "database": "up",
              "migrations": "up"
            }
          }
        },
        "required": [
          "status",
          "service",
          "checks"
        ]
      }
    }
  }
}
