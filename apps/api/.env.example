NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://luckgage:luckgage_local@localhost:5433/luckgage?schema=public
JWT_ACCESS_SECRET=development-only-change-this-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=8
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Optional local bootstrap. Set both email and password; never commit real credentials.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=Luckgage Admin
